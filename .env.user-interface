# Environment used only by the Playwright user interface suite (tests/).
#
# The suite runs the Vite dev server standalone (`vite --mode user-interface`, no Django)
# and intercepts every backend request with Playwright's page.route(), so none of these
# values are ever used to reach a real service - they only need to be present and
# well-formed so the app boots. Do not put real secrets/URLs in this file; it is
# committed to git.

# Deliberately "/" rather than the "/nova/" example in .env.sample: DesktopLayout.vue and
# MobileLayout.vue hide the header Login button via `route.path.startsWith("/launch")`,
# which only matches when the app is mounted at the root. Using "/" here lets RUN_SHEET
# section 5's documented behavior (no header Login button on /launch/:tool) actually be
# exercised; it does not need to match whatever path production is deployed under.
VITE_BASE_PATH=/
VITE_DASHBOARD_TITLE="NOVA Dashboard"
VITE_GALAXY_ALIAS=NDIP
VITE_GALAXY_URL=http://galaxy.invalid
VITE_GALAXY_DOCS_URL=http://galaxy.invalid/docs
VITE_GALAXY_PROJECT_URL=http://galaxy.invalid/project
VITE_NOVA_ALIAS=NOVA
VITE_NOVA_DOCS_URL=http://nova.invalid/docs
VITE_NOVA_TUTORIAL_URL=http://nova.invalid/tutorial
VITE_CHANGELOG_URL=http://nova.invalid/changelog
VITE_SUPPORT_EMAIL=ndip-support@ornl.gov
VITE_LOGIN_URL=http://galaxy.invalid/login/start?redirect=
VITE_GALAXY_HISTORY_NAME=launcher_history
VITE_TOOL_PREFIX=nova
VITE_EXTRA_TOOLS="neutrons_remote_command"

# Intentionally left unset.
#
# VITE_MOCK_USER_*: if set, src/vue/src/stores/user.js takes a shortcut that always logs
# the user in and never calls /api/whoami - which would make it impossible for tests to
# exercise the logged-out state. Instead tests/support/auth.py intercepts GET
# **/api/whoami and GET **/api/users/*/api_key directly, so every test can choose
# logged-in vs logged-out via Playwright's page.route().
VITE_MOCK_USER_EMAIL=
VITE_MOCK_USER_API_KEY=
# VITE_NOTIFICATION_MESSAGE is build-time (App.vue reads import.meta.env directly), so
# setting it would pin the warning banner into every test's layout. Left unset.
VITE_NOTIFICATION_MESSAGE=
# No tool is forced to fail in the suite; failures are simulated via page.route() instead.
VITE_TEST_TOOL_ID=
